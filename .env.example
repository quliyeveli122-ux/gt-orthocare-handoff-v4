# --- Django core -------------------------------------------------
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=0
ALLOWED_HOSTS=gtorthocare.ge,www.gtorthocare.ge
CSRF_TRUSTED_ORIGINS=https://gtorthocare.ge,https://www.gtorthocare.ge

# --- Single-server stack (docker compose) -------------------------
# Domain served by Caddy. Use ":80" for local testing (plain HTTP),
# a real domain in production (automatic HTTPS via Let's Encrypt).
DOMAIN=:80
POSTGRES_PASSWORD=change-me-strong
# GUNICORN_WORKERS=3

# --- Database ------------------------------------------------------
# docker compose sets DATABASE_URL automatically (Postgres in the stack).
# Leave unset for local SQLite development, or point to external Postgres/RDS:
# DATABASE_URL=postgres://gtortho:PASSWORD@your-rds-host.eu-central-1.rds.amazonaws.com:5432/gtorthocare

# --- Media --------------------------------------------------------
# Local disk by default. Point to an attached volume in production,
# or switch to S3 (see settings.py STORAGES comment).
# MEDIA_ROOT=/var/app/media

# --- Email (order notifications) ----------------------------------
# Console backend by default (prints to logs). For real email use SMTP/SES:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=email-smtp.eu-central-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# DEFAULT_FROM_EMAIL=noreply@gtorthocare.ge
# ORDER_NOTIFICATION_EMAIL=info@gtorthocare.ge
